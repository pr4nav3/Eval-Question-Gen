# Local LiteLLM/OpenAI-compatible endpoint for judge calls.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=replace-me
EVAL_LLM_MODEL=private-large

# Local Vespa query endpoint used for exact assignment-chunk hydration.
# This is machine-specific. Use the host port that reaches the Vespa query
# service containing kb_items. Docker setups often map host 18081 -> container
# 8081; native/local setups may use 8081 directly.
VESPA_QUERY_URL=http://localhost:18081/search/

# Optional judge/runtime tuning.
LLM_TIMEOUT_SECONDS=180
LLM_RETRIES=2
